; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="MiniVille"
run/main_scene="uid://xg6ijxmum5pm"
config/features=PackedStringArray("4.6", "GL Compatibility")
boot_splash/bg_color=Color(0.27327007, 0.41344216, 0.9878225, 1)
boot_splash/stretch_mode=2
boot_splash/image="res://icon_minivilles.webp"
config/icon="uid://c3brderihwmjs"

[audio]

buses/default_bus_layout="uid://cjihtogdq8orn"

[autoload]

GameData="*res://script/Class/GameData.gd"
PlayerData="*res://script/scene/Multijoueur/player_data.gd"
LocaleManager="*res://script/scene/Traduction/locale_manager.gd"
LobbyManager="*res://script/scene/Multijoueur/lobby_manager.gd"
SoundManager="*res://scene/Musique/sound_manager.tscn"
NetworkManager="*res://Autoload/NetworkManager.gd"
Client="*res://client.gd"
LobbyHandler="*res://Autoload/lobby_handler.gd"
Game_Client="*res://script/Class/game_client.gd"
